# Runtime backend credential only. Leave empty for the no-provider local smoke test.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Local Free-tier use only; no hosting provision is authorized.
# Fixed request budget: 4,500 estimated input + 2,000 completion; 1,500 headroom.
# Check project restrictions and remaining shared quota in the console first.
PROVIDER_TIMEOUT_SECONDS=30
# Exact browser origin; no trailing slash. Also embedded in the frontend at build.
PUBLIC_ORIGIN=http://localhost:8080
